# cl-hive Production Config (Trusted Fleet Coordination)
# Copy to ~/.lightning/config or include via: include /path/to/cl-hive.conf

# ============================================================================
# NETWORK LIMITS
# ============================================================================

# Maximum Hive members (Dunbar cap for gossip efficiency)
hive-max-members=9

# Maximum market share per target (anti-monopoly, 0.20 = 20%)
hive-market-share-cap=0.10

# ============================================================================
# COORDINATION PROTOCOL
# ============================================================================

# Hold period before committing an Intent (allows conflict detection)
hive-intent-hold-seconds=60

# Capacity change threshold to trigger gossip broadcast (0.10 = 10%)
hive-gossip-threshold=0.10

# Heartbeat broadcast interval in seconds
hive-heartbeat-interval=300

# ============================================================================
# TOPOLOGY PLANNER
# ============================================================================

# Planner cycle interval in seconds (how often to analyze topology)
hive-planner-interval=3600

# ============================================================================
# DATABASE
# ============================================================================

# Path to SQLite database for Hive state
#hive-db-path=~/.lightning/cl_hive.db
